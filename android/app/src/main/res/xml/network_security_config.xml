<?xml version="1.0" encoding="utf-8"?>
<!--
  Autorise le trafic HTTP (non chiffré) tant que le backend n'est pas encore
  servi en HTTPS. À retirer une fois l'URL de production en https:// confirmée.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
